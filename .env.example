# Copiez ce fichier en `.env` et renseignez les valeurs.
# Le `.env` est ignoré par git : aucun secret ne doit entrer dans l'historique.

# ── Base de données ────────────────────────────────────────────────────
# URL PostgreSQL complète (Neon, Supabase, Vercel Postgres…).
DATABASE_URL="postgres://utilisateur:motdepasse@hote/base?sslmode=require"

# ── Accès à l'administration ───────────────────────────────────────────
# Empreinte du mot de passe, JAMAIS le mot de passe lui-même.
# Générez-la avec :  pnpm run motdepasse
ADMIN_PASSWORD_HASH="pbkdf2$210000$...$..."

# Clé de signature des sessions — 32 caractères minimum, tirée au hasard.
# Générez-la avec :  openssl rand -base64 48
# La changer déconnecte immédiatement toutes les sessions ouvertes.
SESSION_SECRET=""

# ── Photos des athlètes ────────────────────────────────────────────────
# Jeton Vercel Blob. Vide en local : les photos sont alors refusées
# proprement, sans faire tomber le reste de l'application.
BLOB_READ_WRITE_TOKEN=""

# Facultatif. Si défini, Vercel l'envoie au cron de /api/sante (Authorization:
# Bearer …) et la route lui rend le diagnostic complet. Sans session ni ce
# secret, /api/sante ne dit que « en ordre » ou « en panne ».
# CRON_SECRET=
